options gen2
require daslib/fio

[export]
def initialize(project_path : string) {
    if (das_is_dll_build()) {
        register_dynamic_module("{project_path}/_build/Release/dasModuleRaylibGen.shared_module", "Module_dasRaylib")
    }
    register_native_path("raylib", "raylib_boost", "{project_path}/raylib/raylib_boost.das")
}
