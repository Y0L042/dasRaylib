options gen2

// Smoke test for the generated dasRaylib module.
//   daslang -load_module <repo>/dasRaylib dasRaylib/examples/hello_raylib.das
require raylib
require raylib/raylib_boost
require math

[export]
def main {
    // raymath + rcamera, no window needed
    let a = Vector3(x = 1.0, y = 2.0, z = 3.0)
    let b = Vector3(x = 4.0, y = 5.0, z = 6.0)
    let s = Vector3Add(a, b)
    print("Vector3Add = ({s.x}, {s.y}, {s.z})  DEG2RAD = {DEG2RAD}  raylib {RAYLIB_VERSION_MAJOR}.{RAYLIB_VERSION_MINOR}\n")

    var cam = Camera3D(
        position = Vector3(x = 10.0, y = 10.0, z = 10.0),
        target = Vector3(x = 0.0, y = 0.0, z = 0.0),
        up = Vector3(x = 0.0, y = 1.0, z = 0.0),
        fovy = 45.0,
        projection = int(CameraProjection.CAMERA_PERSPECTIVE))
    let fwd = GetCameraForward(unsafe(addr(cam)))
    print("GetCameraForward = ({fwd.x}, {fwd.y}, {fwd.z})\n")

    SetConfigFlags(ConfigFlags.FLAG_WINDOW_RESIZABLE)
    InitWindow(800, 450, "dasRaylib - generated by dasClangBind")
    SetTargetFPS(60)
    var frame = 0
    while (!WindowShouldClose() && frame < 180) {
        UpdateCamera(unsafe(addr(cam)), CameraMode.CAMERA_ORBITAL)
        BeginDrawing()
        ClearBackground(RAYWHITE)
        BeginMode3D(cam)
        DrawCube(Vector3(x = 0.0, y = 0.0, z = 0.0), 2.0, 2.0, 2.0, RED)
        DrawCubeWires(Vector3(x = 0.0, y = 0.0, z = 0.0), 2.0, 2.0, 2.0, MAROON)
        DrawGrid(10, 1.0)
        EndMode3D()
        DrawText("Hello from generated raylib bindings!", 10, 10, 20, DARKGRAY)
        DrawFPS(10, 40)
        EndDrawing()
        frame++
    }
    CloseWindow()
    print("ran {frame} frames\n")
}
