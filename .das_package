options gen2
require daslib/daspkg

[export]
def package() {
    package_name("raylib")
    package_description("raylib bindings for daslang, using native daslang math types")
    package_author("Y0L042")
    package_source("https://github.com/Y0L042/dasRaylib")
    package_license("Zlib")
}

[export]
def build() {
    cmake_build()
}

[export]
def release() {
    let p = get_platform_name()
    if (p == "windows") {
        release_include("_build/Release/raylib.dll")
    } elif (p == "darwin") {
        release_include("_build/Release/libraylib.620.dylib")
    } else {
        release_include("_build/Release/libraylib.so.620")
    }
}
